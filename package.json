{
  "name": "wiki-ui-assets",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "css:build": "tailwindcss -i ./internal/web/assets/css/input.css -o ./internal/web/assets/dist/app.css --minify",
    "css:watch": "pnpm run css:build && chokidar \"internal/web/templates/**/*.tmpl\" \"internal/web/assets/css/input.css\" -c \"pnpm run css:build\" --debounce 200",
    "css:watch:tailwind": "tailwindcss -i ./internal/web/assets/css/input.css -o ./internal/web/assets/dist/app.css --minify --watch",
    "test:js": "node --test internal/web/assets/js/*.test.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.7",
    "chokidar-cli": "^3.0.0",
    "daisyui": "^5.0.35",
    "tailwindcss": "^4.1.7"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19"
  }
}
