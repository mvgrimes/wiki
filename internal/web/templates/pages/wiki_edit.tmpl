{{define "pages/wiki_edit"}}
    <main class="mx-auto max-w-5xl px-4 py-8 md:py-10">
      <section class="rounded-2xl border border-base-300 bg-gradient-to-br from-base-100 via-base-100 to-base-200/70 p-6 shadow-sm md:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Wiki entry</p>
        <h1 class="mt-3 text-4xl font-black leading-tight text-balance md:text-5xl">Edit {{.Title}}</h1>
        <p class="mt-3 text-base text-base-content/75 md:text-lg">/wiki/{{.Slug}}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/wiki/{{.Slug}}" class="btn btn-outline">View page</a>
          <a href="/wiki/index" class="btn btn-outline">Back to index</a>
        </div>
      </section>
      {{if .Error}}<p class="mt-4 text-error">{{.Error}}</p>{{end}}
      <form method="post" action="/wiki/{{.Slug}}/edit">
        <div
          id="editor-app"
          data-page-slug="{{.Slug}}"
          data-initial-markdown="{{.Body}}"
          x-data="wikiEditor"
          class="mt-8 grid gap-4 overflow-hidden lg:grid-cols-2"
        >
          <section class="flex flex-col h-[70vh] w-full">
            <h2 class="text-2xl">Editor</h2>
            <textarea
              id="wiki-body"
              name="body"
              class="textarea textarea-bordered flex-1 w-full min-h-96 overflow-y-scroll"
              x-model="markdown"
              @input.debounce.750ms="refreshPreview()"
            ></textarea>
          </section>
          <section class="flex flex-col h-[70vh] w-full">
            <h2 class="text-2xl">Live preview</h2>
            <div id="markdown-preview" aria-live="polite" x-html="previewHTML"
            class="prose prose-li:my-0 prose-h1:mb-2 prose-h2:my-2 flex-1 w-full min-h-96 overflow-y-scroll rounded border border-gray-300 p-3"></div>
          </section>
        </div>
        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <section class="grid gap-4 lg:grid-cols-2">
            <h2 class="text-2xl">Attachments</h2>
            <p>Drop files here or choose files to upload.</p>
            <div id="upload-dropzone" class="rounded border-2 border-dashed border-gray-500 p-4 data-[active=true]:border-cyan-700 data-[active=true]:bg-cyan-50">Drop files here</div>
            <input id="upload-input" type="file" multiple class="max-w-full" />
            <progress id="upload-progress" value="0" max="100" hidden></progress>
            <p id="upload-status" aria-live="polite"></p>
          </section>
          <button type="submit" class="btn btn-primary">Save revision</button>
        </div>
      </form>
      <script type="module" src="/assets/js/wiki_edit.js"></script>
      <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    </main>
{{end}}
