WIKI_SERVER_ADDRESS=0.0.0.0
WIKI_SERVER_PORT=8081
WIKI_SERVER_URL=https://wiki.local
WIKI_SSO_LOGIN_URL=https://sso.local
WIKI_ENVIRONMENT=development
WIKI_LOG_LEVEL=info

WIKI_DATABASE_URL=./data/wiki.db
WIKI_SESSION_SECRET=replace-with-strong-random-secret
WIKI_JWT_SECRET=replace-with-strong-random-secret

WIKI_AWS_ACCESS_KEY_ID=wiki
WIKI_AWS_SECRET_ACCESS_KEY=wiki1234
WIKI_AWS_REGION=us-east-1
WIKI_S3_ENDPOINT=http://localhost:9100
WIKI_S3_BUCKET=wiki-uploads
WIKI_S3_FORCE_PATH_STYLE=true

WIKI_BRANDING=Company Inc.
WIKI_LOGO=base64-encoded-logo-or-URL
WIKI_LOGO_HERO=base64-encoded-logo-or-URL
WIKI_FAVICON=base64-encoded-logo-or-URL
